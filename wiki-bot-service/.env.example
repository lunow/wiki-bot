# ── Identity: what this deployment is about ─────────────────────────
BOT_NAME=Wiki Bot
WIKI_DOMAIN=a personal knowledge base
# Optional extra rules for answers / for how notes are filed
QUERY_GUIDANCE=
INGEST_GUIDANCE=
# Optional label on analytics events (lets deployments share one PostHog project)
INSTANCE_NAME=

# ── Telegram (one bot per deployment) ───────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_WEBHOOK_URL=https://wiki-bot.yourdomain.com/telegram
# Random string (A-Z a-z 0-9 _ -) Telegram echoes back on every webhook call
TELEGRAM_WEBHOOK_SECRET=change-me
ALLOWED_CHAT_IDS=12345678,87654321
# Bearer token for GET /trigger-remind/{name}
ADMIN_TOKEN=change-me

# ── The wiki repo ───────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=yourusername/your-wiki
GITHUB_BRANCH=main
# Keep each raw note as a Source page in wiki/references/ (true|false)
SAVE_RAW_NOTES=true

# ── LLM ─────────────────────────────────────────────────────────────
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# OpenAI key, only needed for voice messages
WHISPER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Reminders (optional; none by default) ───────────────────────────
# JSON list, or a file path. See examples/property-reminders.json
REMINDERS=
REMINDERS_FILE=
TZ=Europe/Berlin

# ── PostHog (optional) ──────────────────────────────────────────────
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://eu.i.posthog.com
# Optional: secret for pseudonymising chat IDs (defaults to the Telegram bot token)
POSTHOG_ID_SALT=
# Set to true to send full prompts/responses to PostHog (default: sizes only)
POSTHOG_CAPTURE_CONTENT=false
